# Backend
DATABASE_URL=sqlite:///./hyperpulse.db
# DATABASE_URL=postgresql://hyperpulse:hyperpulse@localhost:5432/hyperpulse
POSTGRES_USER=hyperpulse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hyperpulse
REDIS_URL=redis://localhost:6379/0
API_HOST=0.0.0.0
API_PORT=8100
API_DOCS_ENABLED=true
CORS_ALLOW_CREDENTIALS=false
CORS_ORIGINS=http://localhost:3100
# Required for POST /api/v2/pipeline/run when ENVIRONMENT is production, prod, or staging.
# Send it as the X-Pipeline-Token request header; leave empty for local development only.
ENVIRONMENT=development
PIPELINE_RUN_TOKEN=

# Hyperliquid collectors
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
COLLECTOR_ENABLED=true
COLLECTOR_INTERVAL_SECONDS=60

# AI inference
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
LANGGRAPH_URL=
INFERENCE_INTERVAL_SECONDS=120

# Smart money ranking
RANKING_INTERVAL_SECONDS=90

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Retries apply only to a single outbound message; failed sends remain in alert history.
TELEGRAM_SEND_ATTEMPTS=3
TELEGRAM_RETRY_DELAY_SECONDS=1
ALERTS_ENABLED=true
ALERT_MIN_CONFIDENCE=70
ALERT_MIN_SIZE_USD=500000
# Global ceiling + per-type hourly caps (big_trade is noisiest → tightest)
ALERT_MAX_PER_HOUR=8
ALERT_LIMIT_BIG_TRADE_PER_HOUR=2
ALERT_LIMIT_WHALE_MOVE_PER_HOUR=3
ALERT_LIMIT_CONSENSUS_PER_HOUR=2
# Market Brief Telegram is 2 desk slots/day (Asia 09:00 + US 09:00), not a live ticker.
# This cap is a safety net inside one hour; the slot gate is the real limiter.
ALERT_LIMIT_MARKET_BRIEF_PER_HOUR=1
ALERT_LIMIT_SQUEEZE_PER_HOUR=1
ALERT_LIMIT_STYLE_PER_HOUR=1
ALERT_BIG_TRADE_PER_CYCLE=1
ALERT_WHALE_MOVE_PER_CYCLE=1

# CoinMarketCap (optional — Fear & Greed works keyless; key raises rate limits)
CMC_API_KEY=

# Frontend
API_URL=http://127.0.0.1:8100
NEXT_PUBLIC_API_URL=http://127.0.0.1:8100
# Optional: Telegram public channel URL or private invite URL displayed on /alerts.
# Example: https://t.me/hyperpulse_alerts or https://t.me/+inviteCode
NEXT_PUBLIC_TELEGRAM_CHANNEL_URL=
