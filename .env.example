# Backend
DATABASE_URL=sqlite:///./hyperpulse.db
# DATABASE_URL=postgresql://hyperpulse:hyperpulse@localhost:5432/hyperpulse
REDIS_URL=redis://localhost:6379/0
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Hyperliquid collectors
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
COLLECTOR_ENABLED=true
COLLECTOR_INTERVAL_SECONDS=60

# AI inference
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
LANGGRAPH_URL=
INFERENCE_INTERVAL_SECONDS=120

# Smart money ranking
RANKING_INTERVAL_SECONDS=90

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERTS_ENABLED=true
ALERT_MIN_CONFIDENCE=70
ALERT_MIN_SIZE_USD=500000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
